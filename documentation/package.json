{
  "name": "adminforth",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "gendoc": "typedoc",
    "docusaurus": "docusaurus",
    "build:afcl": "pnpm --dir ../adminforth install && ln -sfn ../../adminforth/spa/node_modules afcl-preview/node_modules && node afcl-preview/node_modules/vite/bin/vite.js build afcl-preview",
    "copy:agent-logos": "cp -r ../adminforth/spa/src/assets/agents static/landing-previews/",
    "start": "pnpm build:afcl && pnpm copy:agent-logos && docusaurus start",
    "build": "pnpm build:afcl && pnpm copy:agent-logos && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "DEPLOYMENT_BRANCH=main docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docsearch/react": "^3.6.0",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "@types/prismjs": "^1.26.4",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react-dom": "^18.0.0",
    "react-image-gallery": "^1.3.0",
    "react-terminal-ui": "^1.3.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.2.14",
    "docusaurus-plugin-llms": "^0.6.1",
    "docusaurus-plugin-typedoc": "^1.4.3",
    "react": "^18.3.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
