# Local env of the live demo: `pnpm dev` copies this file to the gitignored .env when it does not exist yet.
# Production does not use it, it gets its env from the vault (see ../deploy/compose.yml).
ADMINFORTH_SECRET=local-dev-secret
NODE_ENV=development
DATABASE_FILE_URL=file:.db.sqlite
# password of the local superadmin admin1@adminfoth.dev
ADMIN_PASSWORD=admin

# Required: the AI plugins refuse to start without it. Take it from the vault.
OPENAI_API_KEY=
# Optional: only image upload to the demo-static.adminforth.dev bucket needs them.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
